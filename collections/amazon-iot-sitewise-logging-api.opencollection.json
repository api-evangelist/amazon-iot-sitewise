{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS IoT SiteWise Access Policies Logging API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logging",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon IoT SiteWise Describe Logging Options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://iotsitewise.{region}.amazonaws.com/logging",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ]
          },
          "docs": "Retrieves the current IoT SiteWise logging options."
        },
        {
          "info": {
            "name": "Amazon IoT SiteWise Put Logging Options",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://iotsitewise.{region}.amazonaws.com/logging",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets logging options for IoT SiteWise."
        }
      ]
    }
  ],
  "bundled": true
}